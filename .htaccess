# /seo:redirects

# Pages de la racine (adresses du site avant le passage aux langues) -> version française
RewriteRule ^(index|accueil)(\.html)?$ /fr/ [R=301,L]
RewriteRule ^presse(\.html)?/?$ /fr/apropos#presse [R=301,L,NE]
RewriteRule ^(portfolio|galeries|expositions|apropos|contact|mentions-legales|classique|merci)(\.html)?/?$ /fr/$1 [R=301,L]
RewriteRule ^oeuvres/(.+?)(\.html)?$ /fr/oeuvres/$1 [R=301,L]

# /fr/portfolio.html -> /fr/portfolio
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# /fr/portfolio -> sert fr/portfolio.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [END]

# images, styles, scripts demandés depuis une page de langue (/en/images/x.jpg) : servis depuis la racine
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(fr|en|es|it)/(.+)$ /$2 [END]

ErrorDocument 404 /404.html
