# .htaccess — hébergement Apache / LiteSpeed (Hostinger, annickbouvattier.art). GitHub Pages ignore ce fichier.
#
# Le site existe en 4 langues, chacune dans son dossier : /fr/…, /en/…, /es/…, /it/… (pages générées par
# scripts/build-seo.mjs à partir des pages de la racine, qui restent les sources à modifier).
Options -MultiViews
DirectoryIndex index.html
RewriteEngine On

# Accueil « / » : la langue choisie sur le site (cookie posé par i18n.js), sinon celle du navigateur, sinon le français
RewriteCond %{HTTP_COOKIE} (^|;\s*)abouv_lang=(fr|en|es|it)
RewriteRule ^$ /%2/ [R=302,L,E=NOCACHE:1]
RewriteCond %{HTTP:Accept-Language} ^en [NC]
RewriteRule ^$ /en/ [R=302,L,E=NOCACHE:1]
RewriteCond %{HTTP:Accept-Language} ^es [NC]
RewriteRule ^$ /es/ [R=302,L,E=NOCACHE:1]
RewriteCond %{HTTP:Accept-Language} ^it [NC]
RewriteRule ^$ /it/ [R=302,L,E=NOCACHE:1]
RewriteRule ^$ /fr/ [R=302,L,E=NOCACHE:1]
<IfModule mod_headers.c>
  # cette redirection dépend du visiteur : ni le CDN ni le navigateur ne doivent la garder
  Header always set Cache-Control "no-store" env=NOCACHE
  Header always append Vary "Accept-Language, Cookie" env=NOCACHE
</IfModule>

# /fr -> /fr/ ; /fr/index, /fr/accueil -> /fr/ ; /fr/presse -> la presse dans À propos
RewriteRule ^(fr|en|es|it)$ /$1/ [R=301,L]
RewriteRule ^(fr|en|es|it)/(index|accueil)(\.html)?$ /$1/ [R=301,L]
RewriteRule ^(fr|en|es|it)/presse(\.html)?/?$ /$1/apropos#presse [R=301,L,NE]

# Adresses de l'ancien site (générées par scripts/build-seo.mjs depuis data/old-urls.txt : ne pas modifier à la main)
