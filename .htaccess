# .htaccess — adresses propres sur un hébergement Apache / LiteSpeed (ex. Hostinger, annickbouvattier.art).
# (GitHub Pages ignore ce fichier : il sert déjà /portfolio pour portfolio.html.)
Options -MultiViews
RewriteEngine On

# /index.html, /index, /accueil, /accueil.html -> / (le site de base)
RewriteRule ^(index|accueil)(\.html)?$ / [R=301,L]

# /portfolio.html -> /portfolio (et /oeuvres/enigma.html -> /oeuvres/enigma)
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# /portfolio -> sert portfolio.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

ErrorDocument 404 /404.html
